{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/app/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "ui_kits/dashboard/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|progress|payment|success|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'info' | 'progress' | 'payment' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulkActionOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<BulkActionOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|pill|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, pill, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|neutral|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'neutral' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:hover|padded|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: hover, padded, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|mine|text|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: id, mine, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<FieldOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|active|key|ref|className|style|children)$/]",
        "message": "<FilterButton> doesn't accept that prop. Declared props: label, detail, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroPanelStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<HeroPanelStat> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|key|ref|className|style|children)$/]",
        "message": "<InfoBanner> doesn't accept that prop. Declared props: tone, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|error|warning|info)$/]",
        "message": "<InfoBanner> tone must be one of 'success' | 'error' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|message|note|link|type|actionRequired|isRead|key|ref|className|style|children)$/]",
        "message": "<NotificationItem> doesn't accept that prop. Declared props: id, title, message, note, link, type, actionRequired, isRead."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReminderItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|typeLabel|type|severity|title|description|dateLabel|link|key|ref|className|style|children)$/]",
        "message": "<ReminderItem> doesn't accept that prop. Declared props: id, typeLabel, type, severity, title, description, dateLabel, link."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReminderItem'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:info|warning|urgent)$/]",
        "message": "<ReminderItem> severity must be one of 'info' | 'warning' | 'urgent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|align|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, subtitle, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|count|active|key|ref|className|style|children)$/]",
        "message": "<SidebarLink> doesn't accept that prop. Declared props: icon, label, count, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageFilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|active|key|ref|className|style|children)$/]",
        "message": "<StageFilterChip> doesn't accept that prop. Declared props: label, tone, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageFilterChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|progress|payment|success|danger|none)$/]",
        "message": "<StageFilterChip> tone must be one of 'neutral' | 'info' | 'progress' | 'payment' | 'success' | 'danger' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|delta|deltaTone|hint|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: title, value, delta, deltaTone, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='deltaTone'] > Literal[value!=/^(?:up|down|neutral)$/]",
        "message": "<StatCard> deltaTone must be one of 'up' | 'down' | 'neutral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
